<?php defined('BASEPATH') OR exit('No direct script access allowed');

/*
| -------------------------------------------------------------------------
| LOCAL-ONLY MAIL OVERRIDES  (optional)
| -------------------------------------------------------------------------
|
| Copy this file to  application/config/email_local.php  and fill in real SMTP
| credentials if you want the local machine to actually deliver mail (password
| resets, registration notices) while testing.
|
| Without this file, mail sent from localhost is captured to
| application/logs/dev_emails/ and a "view the email" link is shown on screen -
| which is enough to test the whole forgot-password flow offline.
|
| This file is read ONLY when the request comes from localhost / 127.0.0.1 /
| *.local / *.test, so it can never affect how the live server sends mail.
| Do not commit the filled-in copy: it holds a password.
|
| Gmail example: turn on 2-Step Verification, create an App Password at
| https://myaccount.google.com/apppasswords, and paste the 16-character value
| as smtp_pass (not your normal Google password).
*/

$config['protocol']    = 'smtp';
$config['smtp_host']   = 'smtp.gmail.com';
$config['smtp_port']   = 587;
$config['smtp_user']   = 'your.address@gmail.com';
$config['smtp_pass']   = 'your-16-char-app-password';
$config['smtp_crypto'] = 'tls';          // 'tls' with port 587, 'ssl' with port 465
$config['smtp_timeout'] = 10;
$config['mailtype']    = 'html';
$config['charset']     = 'utf-8';
$config['newline']     = "\r\n";
$config['crlf']        = "\r\n";
